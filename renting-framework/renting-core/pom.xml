<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
 
	<parent>
		<groupId>com.rentingframework</groupId>
		<artifactId>renting-framework</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
 
	<artifactId>renting-core</artifactId>
	<packaging>jar</packaging>
	<name>renting-core</name>
	<description>Shared model, service, and repository layer reused by every app</description>
 
	<!--
		No spring-boot-maven-plugin here on purpose. This module is a plain
		library jar consumed by the apps, not a runnable Spring Boot app -
		repackaging it as an executable jar would break its use as a
		dependency. Each app's own pom adds that plugin instead.
	-->
	<dependencies>
 
		<!--
			Needed for @RestControllerAdvice / ResponseEntity, used by the
			shared GlobalExceptionHandler. Every app already brings this in
			too, so there's no real duplication cost.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
 
		<!-- Gives us @Entity, @Id, JOINED inheritance, etc. for the base model classes -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
 
		<!--
			ChatClient lives in core (AIConfig, MatchingStrategy interface),
			since "matching is always LLM-based" is a fixed framework rule,
			not something left to each app to wire up independently.
		-->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
 
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
 
	</dependencies>
 
</project>